# Copy this file to `.env` and fill in values. `.env` is gitignored — never commit real keys.

# --- Tier 0: optional OpenAI content-provenance check (--use-provenance-api flag) ---
OPENAI_API_KEY=

# --- HuggingFace (only needed if a dataset you use is gated; SID_Set is public) ---
HF_TOKEN=

# --- Kaggle (needed for CIFAKE). Get these from kaggle.com -> Account -> Create New API Token,
# which downloads a kaggle.json containing them. You can put them here OR place kaggle.json at
# ~/.kaggle/kaggle.json (Kaggle's own preferred location) instead. ---
KAGGLE_USERNAME=
KAGGLE_KEY=
